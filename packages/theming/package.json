{
  "name": "@pierre/theming",
  "version": "1.0.1",
  "homepage": "https://github.com/pierrecomputer/pierre/tree/main/packages/theming",
  "bugs": {
    "url": "https://github.com/pierrecomputer/pierre/issues"
  },
  "license": "apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pierrecomputer/pierre.git",
    "directory": "packages/theming"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ],
      "color": [
        "dist/color.d.ts"
      ],
