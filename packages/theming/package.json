    "@pierre/theme": "^1.1.0 || ^2.0.0",
    "@shikijs/themes": "^3.0.0 || ^4.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "shiki": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "@pierre/theme": {
      "optional": true
