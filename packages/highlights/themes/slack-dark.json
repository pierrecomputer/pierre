      "punctuation.special": {
        "color": "#808080"
      },
      "string": {
        "color": "#ce9178"
      },
      "string.escape": {
        "color": "#569cd6"
      },
      "string.regex": {
        "color": "#ce9178"
      },
      "string.special": {
        "color": "#ce9178"
      },
      "string.special.symbol": {
        "color": "#ce9178"
      },
      "tag": {
        "color": "#569cd6"
      },
      "text.literal": {
        "color": "#ce9178"
      },
      "type": {
        "color": "#4EC9B0"
      },
      "variable": {
        "color": "#9CDCFE"
      },
      "variable.special": {
        "color": "#569cd6"
      }
