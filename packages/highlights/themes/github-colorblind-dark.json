      "punctuation.delimiter.jsx": {
        "color": "#ff7b72ff"
      },
      "punctuation.list_marker": {
        "color": "#ffa657ff"
      },
      "punctuation.special": {
        "color": "#ff7b72ff"
      },
      "string": {
        "color": "#a5d6ffff"
      },
      "string.escape": {
        "color": "#ff7b72ff"
      },
      "string.regex": {
        "color": "#a5d6ffff"
      },
      "string.special": {
        "color": "#79c0ffff"
