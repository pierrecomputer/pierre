{
  "name": "@pierre/highlights",
  "version": "0.5.1",
  "description": "A fast code highlighter written in WebAssembly Text(Wat), from Pierre",
  "license": "apache-2.0",
  "files": [
    "dist/",
    "NOTICE.md"
  ],
  "type": "module",
  "main": "./dist/default.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/workerd.js",
      "import": "./dist/default.js",
      "default": "./dist/default.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js",
      "default": "./dist/themes.js"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js",
      "default": "./dist/themes/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "moon run highlights:prepublish"
  },
  "devDependencies": {
    "@pierre/wat-tools": "workspace:*",
    "shiki": "catalog:",
    "tree-sitter-highlight": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "meta": {
    "highlights.wasm": 305110,
    "highlights.wasm.gz": 143733
  }
}
