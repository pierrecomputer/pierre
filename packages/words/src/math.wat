    (if (i32.and (i32.eqz (local.get $root)) (i32.ne (i32.and (local.get $params) (i32.const 2048)) (i32.const 0)))
      (then (drop (call $m.rawArg))))
    (global.set $mC (local.get $cells))
    ;; parse the cells
