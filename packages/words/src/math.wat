            (if (i32.and (i32.or (i32.eq (local.get $c) (i32.const "l"))
                  (i32.or (i32.eq (local.get $c) (i32.const "c")) (i32.eq (local.get $c) (i32.const "r"))))
                  (i32.lt_u (local.get $col) (i32.const 63)))
