        (i32.add (i32.load (local.get $a)) (i32.load offset=4 (local.get $a)))))
      (local.set $row (i32.add (local.get $row) (i32.const 1)))
      (br_if $r (i32.lt_u (local.get $row) (local.get $nrows))))
