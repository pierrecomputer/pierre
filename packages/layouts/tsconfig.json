{
  "extends": "../../tsconfig.options.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "demo/**/*.ts",
    "demo/**/*.tsx",
    "test/**/*.ts",
    "bench/**/*.ts",
    "bench/**/*.tsx",
    "tsdown.config.ts"
  ],
  "exclude": ["node_modules", "dist", "demo/dist", "bench/dist"],
  "compilerOptions": {
    "isolatedDeclarations": true,
    "allowJs": false,
    "checkJs": false,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo"
  }
}
