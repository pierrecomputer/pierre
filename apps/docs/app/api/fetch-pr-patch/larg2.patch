+          });
+        }
+      },
+    });
+
+    walk(rule, {
+      visit: 'Declaration',
+      enter(declaration) {
+        if (declaration.property.startsWith('--')) {
+          return;
+        }
+        let value =
           generate(declaration.value) +
           (declaration.important ? '!important' : '');
+        for (const localVarDef of localVariableDefinitions) {
+          const varUsage = `var(${localVarDef.variableName})`;
