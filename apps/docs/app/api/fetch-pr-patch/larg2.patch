+              const b = Number.parseInt(hex.charAt(2) + hex.charAt(2), 16);
+              return `rgb(${r},${g},${b})`;
+            }
+            if (hex.length === 4) {
+              const r = Number.parseInt(hex.charAt(0) + hex.charAt(0), 16);
+              const g = Number.parseInt(hex.charAt(1) + hex.charAt(1), 16);
+              const b = Number.parseInt(hex.charAt(2) + hex.charAt(2), 16);
+              const a =
