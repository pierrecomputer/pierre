From 6bbfa3c2cfd23e62ac8f7e21f9d79f8b023225ec Mon Sep 17 00:00:00 2001
From: Gabriel Miranda <gabrielmfern@outlook.com>
Date: Thu, 4 Sep 2025 16:02:37 -0300
Subject: [PATCH 045/194] use in-house clone that ignores the `parent` property
 to avoid infinte loops

---
 packages/tailwind/src/utils/css/clone.ts      | 29 +++++++++++++++++++
 .../css/sanitize-non-inlinable-classes.ts     |  3 +-
 2 files changed, 31 insertions(+), 1 deletion(-)
 create mode 100644 packages/tailwind/src/utils/css/clone.ts

diff --git a/packages/tailwind/src/utils/css/clone.ts b/packages/tailwind/src/utils/css/clone.ts
new file mode 100644
index 0000000000..2f9bbe7060
--- /dev/null
+++ b/packages/tailwind/src/utils/css/clone.ts
@@ -0,0 +1,29 @@
+import { type CssNode, List } from 'css-tree';
+
+/**
+  * Slightly modified version of csstree's clone, with the difference that it ignores the `parent` property that we add in.
+  */
+export function clone<T extends CssNode>(node: T): T {
+  const result: Record<string, unknown> = {};
+
+  for (const key of Object.keys(node)) {
+    let value: any = node[key as keyof CssNode];
+    if (key === 'parent') {
+      continue;
+    }
+
+    if (value) {
+      if (value instanceof List) {
+        value = value.map(clone);
+      } else if (Array.isArray(value)) {
+        value = value.map(clone);
+      } else if (value.constructor === Object) {
+        value = clone(value);
+      }
+    }
+
+    result[key] = value;
+  }
+
+  return result as T;
+}
